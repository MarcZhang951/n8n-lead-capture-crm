    {
      "id": "0ecc6fc7-ee58-46ee-ac74-6005668fe72a",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        500
      ],
      "parameters": {
        "jsCode": "// Try/catch fallback: warm / 50+\nconst lead = $('Normalize (Web)').item.json;\nlet ai;\ntry {\n  ai = $json.message.content;\n  if (typeof ai === 'string') ai = JSON.parse(ai);\n} catch (e) {\n  ai = { score: 50, tier: 'warm', reason: 'LLM parse failed - fallback', message: '' };\n}\nreturn [{ json: { ...lead, score: Number(ai.score) || 50, reason: ai.reason, aiMessage: ai.message } }];"
      }
    },
    {
      "id": "e743e763-3688-4a05-9835-ab6c4dac488f",
      "name": "Apply Rules Floor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        500
      ],
      "parameters": {
        "jsCode": "// Floor rule: corp email + budget + long msg\nconst rules = $('Scoring Rules (edit here)').item.json;\nconst lead = $json;\nconst freeMail = /@(gmail|yahoo|hotmail|outlook|qq|163)\\./i.test(lead.email);\nlet score = lead.score;\nif (!freeMail && lead.budget >= rules.budgetFloor && (lead.message || '').length >= rules.longMessageChars) {\n  score = Math.max(score, rules.corpEmailFloor);\n}\nconst tier = score >= rules.hotThreshold ? 'hot' : score >= rules.warmThreshold ? 'warm' : 'cold';\nreturn [{ json: { ...lead, score, tier } }];"
      }
    },
