    {
      "id": "1f01ab20-dfcc-4f09-89c3-9b15fac41bb7",
      "name": "Prepare Update Diff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2460,
        820
      ],
      "parameters": {
        "jsCode": "const prev = $('Search by Email').item.json.properties || {};\nconst lead = $json;\nconst diff = ['phone', 'company'].filter(k => prev[k] && prev[k] !== lead[k])\n  .map(k => `${k}: ${prev[k]} → ${lead[k]}`);\nreturn [{ json: { ...lead, diff: diff.join('\\n') || 'no field changes' } }];"
      }
    },
